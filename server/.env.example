PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmaexpress
DB_USER=postgres
DB_PASSWORD=postgres
# Base usada por `npm test` (se borra y recrea en cada corrida)
DB_NAME_TEST=farmaexpress_test
# Clave para firmar las sesiones JWT: cámbiala por una cadena larga y aleatoria
JWT_SECRET=cambia-esta-clave-larga-y-aleatoria
# RNF-03: minutos de inactividad antes de cerrar la sesión
SESSION_MINUTES=15
