{
  "name": "farmaexpress",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "db:setup": "npm --prefix server run db:setup",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
